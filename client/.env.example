# URL completa do backend em produção (sem barra no fim). Deixe em branco em dev local —
# o Vite já faz proxy de /api para http://localhost:4100 (ver vite.config.js).
# Exemplo em produção: VITE_API_BASE_URL=https://izicripto-api.onrender.com
VITE_API_BASE_URL=

# Config do Firebase Web SDK (não são segredos — só identificam o projeto; a segurança
# vem das Regras de Segurança configuradas no console do Firebase). Só precisa preencher
# se for usar um projeto Firebase diferente do padrão embutido em src/firebase.js.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
