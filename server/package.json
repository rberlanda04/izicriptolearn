{
  "name": "izicripto-platform-server",
  "version": "1.0.0",
  "description": "API CRUD de cursos da plataforma iziCripto",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "postinstall": "prisma generate",
    "start": "prisma db push --skip-generate --accept-data-loss && node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seedPrisma.js",
    "apply-diagrams": "node src/applyDiagrams.js",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio"
  },
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.0.0",
    "stripe": "^17.0.0"
  }
}
