PORT=4100

# Firestore é o banco de dados. Em dev local, baixe uma chave de conta de serviço com
# `gcloud iam service-accounts keys create server/secrets/firebase-admin.json
#   --iam-account=<seu-service-account>@<seu-projeto>.iam.gserviceaccount.com`
# (nunca commitada — ver .gitignore). Em produção, defina FIREBASE_SERVICE_ACCOUNT_BASE64
# com esse mesmo JSON codificado em base64 numa variável de ambiente só.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Gere um valor aleatório próprio: `openssl rand -hex 32`
JWT_SECRET=

# Stripe (opcional) — deixe em branco para rodar sem cobrança real.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
CLIENT_URL=http://localhost:5180

# Usados só por `npm run seed` para criar o usuário admin inicial.
ADMIN_SEED_EMAIL=admin@izicripto.dev
ADMIN_SEED_PASSWORD=

# Opcional, não usado hoje — capas dos cursos usam Pollinations.ai (grátis, sem chave).
# Só preencha se quiser trocar por um modelo pago da OpenRouter no futuro.
OPENROUTER_API_KEY=

# Opcional, apenas para gerar capas com Gemini no futuro (requer billing ativado no
# Google Cloud para modelos de imagem — ver scripts/generate-covers.js).
GEMINI_API_KEY=

# Opcional — ativa o analista de IA consultivo do Simulador de Trade (chat + comentários
# sobre trades). Sem isso, o simulador funciona normalmente, só sem o chat de IA.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
